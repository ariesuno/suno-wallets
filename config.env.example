# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=suno_wallets
DB_SSL_MODE=disable

# Configurações do Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=suno_redis_password
REDIS_DB=0

# Configurações da Aplicação
APP_PORT=8080
APP_ENV=development
GIN_MODE=debug

# Configurações de JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Configurações de Log
LOG_LEVEL=info
LOG_FORMAT=json

# Configurações de Multi-tenant
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Configurações de CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Tenant-ID

# Configurações B3 (OAuth2 + mTLS)
B3_URL_OPTIN=
B3_URL_DATA=
B3_OAUTH_TOKEN_URL=
B3_CLIENT_ID=
B3_CLIENT_SECRET=
B3_SCOPE=
B3_CERT_P12_PATH=certs/b3_certificate12filepath.p12
B3_CERT_PASSPHRASE=
B3_LEGACY_CERT_PATH=certs/b3_certificatefilepath.cer
B3_TIMEOUT_SECONDS=10
B3_MAX_RETRIES=3
B3_INITIAL_BACKOFF_MS=200
B3_MAX_BACKOFF_MS=2000