meta { name: Admin Incremental from Last type: http }
vars { baseUrl: {{baseUrl}} tenantId: {{tenantId}} adminSecret: {{adminSecret}} cpf: 00000000000 }
request { method: POST url: {{baseUrl}}/api/v1/b3/admin/incremental-from-last }
headers { X-Tenant-Id: {{tenantId}} X-Admin-Secret: {{adminSecret}} Content-Type: application/json }
body:json { cpf: "{{cpf}}" dataTypes: ["transactions","positions"] assetTypes: ["equity"] since: null dryRun: true force: false concurrency: 2 }


