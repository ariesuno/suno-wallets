meta {
  name: Client Policy
  type: http
  seq: 1
}

env "local" {
  var base_url = "http://localhost:8080/api/v1"
  var tenant_id = "00000000-0000-0000-0000-000000000001"
  var cpf = "00000000000"
}

req "Get policy" {
  get: "{{base_url}}/admin/client/policy?cpf={{cpf}}"
  headers { X-Tenant-Id: "{{tenant_id}}" }
}

req "Upsert policy" {
  post: "{{base_url}}/admin/client/policy"
  headers { X-Tenant-Id: "{{tenant_id}}" Content-Type: "application/json" }
  body: json {
    cpf: "{{cpf}}",
    mode: "HYBRID",
    reason: "enable manual + b3"
  }
}

req "Audit policy" {
  get: "{{base_url}}/admin/client/policy/audit?cpf={{cpf}}"
  headers { X-Tenant-Id: "{{tenant_id}}" }
}

req "Dry-run policy" {
  post: "{{base_url}}/admin/client/policy/dry-run"
  headers { X-Tenant-Id: "{{tenant_id}}" Content-Type: "application/json" }
  body: json {
    cpf: "{{cpf}}",
    newMode: "MANUAL_ONLY"
  }
}


