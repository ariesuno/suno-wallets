meta {
  name: B3 - Sync Run
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/b3/sync/run
  body: json
}

headers {
  X-Tenant-ID: {{tenantId}}
  Content-Type: application/json
}

body:json {
  {
    "scope": "single",
    "cpf": "{{cpf}}",
    "dataTypes": ["transactions", "positions"],
    "assetTypes": ["equity"],
    "force": false,
    "dryRun": true,
    "limit": 100
  }
}