{
    "title": "B3 E2E + Incremental",
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
        {
            "type": "graph",
            "title": "E2E Runs (rate) por resultado",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum by (result) (rate(b3_e2e_runs_total[5m]))",
                    "legendFormat": "{{result}}"
                }
            ]
        },
        {
            "type": "graph",
            "title": "E2E Errors (rate) por stage",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum by (stage) (rate(b3_e2e_errors_total[5m]))",
                    "legendFormat": "{{stage}}"
                }
            ]
        },
        {
            "type": "graph",
            "title": "E2E Latência p95 (s)",
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(b3_e2e_duration_seconds_bucket[5m])))",
                    "legendFormat": "p95"
                }
            ]
        },
        {
            "type": "graph",
            "title": "E2E Latência p99 (s)",
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
