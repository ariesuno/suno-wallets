meta {
  name: Admin Incremental from Last
  type: http
}

request {
  method: POST
  url: http://localhost:8080/api/v1/b3/admin/incremental-from-last
  headers: {
    Content-Type: application/json
    X-Tenant-ID: {{TENANT_ID}}
    X-Admin-Secret: {{ADMIN_SECRET}}
  }
  body: json({
    cpf: "00000000000",
    dataTypes: ["transactions", "positions"],
    assetTypes: ["equity"],
    since: null,
    dryRun: true,
    force: false,
    concurrency: 2
  })
}


