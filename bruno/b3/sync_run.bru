meta {
  name: Sync Run
  type: http
}

request {
  method: POST
  url: http://localhost:8080/api/v1/b3/sync/run

  headers: {
    X-Tenant-Id: <TENANT_ID>
    Content-Type: application/json
  }

  body: json {
    scope: "single"
    cpf: "12345678901"
    dataTypes: ["transactions", "positions"]
    assetTypes: ["equity"]
    force: false
    dryRun: true
    limit: 100
  }
}


