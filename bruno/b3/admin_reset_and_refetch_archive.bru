meta {
  name: Admin Reset & Refetch (archive)
  type: http
}

request {
  method: POST
  url: http://localhost:8080/api/v1/b3/admin/reset-and-refetch
  headers: {
    Content-Type: application/json
    X-Tenant-ID: {{TENANT_ID}}
    X-Admin-Secret: {{ADMIN_SECRET}}
  }
  body: json({
    cpf: "00000000000",
    dryRun: false,
    force: true,
    assetTypes: ["equity"],
    dataTypes: ["transactions", "positions"],
    mode: "archive",
    confirm: "RESET_AND_REFETCH"
  })
}


