meta {
  name: Admin Reset & Refetch (dry run)
  type: http
}

request {
  method: POST
  url: http://localhost:8080/api/v1/b3/admin/reset-and-refetch
  headers: {
    Content-Type: application/json
    X-Tenant-ID: {{TENANT_ID}}
  }
  body: json({
    cpf: "00000000000",
    dryRun: true,
    confirm: "RESET_AND_REFETCH",
    mode: "archive"
  })
}


